AI_PROVIDER=native
AI_OFFLINE=1
LOCAL_AI_BASE_URL=http://127.0.0.1:11436
LOCAL_AI_NUM_CTX=32768
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192
# ODA_CONVERTER=C:/Program Files/ODA/ODAFileConverter 27.1.0/ODAFileConverter.exe
# Auto-detected; required for checked profile resize and supported solid fits.
# Uses FreeCAD's bundled Python offline; does not infer strength or full assembly fit.
# FREECAD_PYTHON=C:/Program Files/FreeCAD 1.1/bin/python.exe
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-6-astra
OPENAI_API_KEY=replace_with_your_api_key
CAD_FREE_MODE=1
CAD_DWG_ENABLED=1

# CAD engine and AI provider are independent. Enable cloud only after setup.
CAD_DWG_BACKEND=aps
# Omit to follow CAD_DWG_BACKEND, or choose aps/oda/autocad for new uploads.
CAD_READ_BACKEND=aps
APS_CLOUD_ENABLED=0
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Globally unique OSS bucket name; persistent, private to this APS app.
APS_BUCKET_KEY=
# Output from scripts/setup_aps.py register: nickname.MechanicalCad+dev
APS_ACTIVITY_ID=
APS_REGION=us-east
# Default plugin targets the AutoCAD 2025 .NET 8 engine. Check live engines first.
APS_ENGINE=Autodesk.AutoCAD+25_0

# PostgreSQL optional. Blank keeps the existing SQLite APS history.
DATABASE_URL=
# Setup only; remove admin password after provisioning the dedicated app role.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
PGHOST=127.0.0.1
PGPORT=5432

# Local AutoCAD backend: build/check/activate after licensed AutoCAD is installed.
# CAD_DWG_BACKEND=autocad
# CAD_READ_BACKEND=autocad
AUTOCAD_CORE_CONSOLE=
AUTOCAD_TIMEOUT_SECONDS=300
# Optional override; AutoCAD 2027 auto-uses the prepared portable .NET 10.
AUTOCAD_DOTNET_ROOT=
